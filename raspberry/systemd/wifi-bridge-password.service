[Unit]
Description=Change the fixed Astro Bridge Linux account password

[Service]
Type=oneshot
WorkingDirectory=/opt/wifi-bridge
ExecStart=/usr/bin/python3 /usr/local/lib/astro-bridge/password.py
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
