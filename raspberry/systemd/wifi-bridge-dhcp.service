[Unit]
Description=Astro Bridge — DHCP for the isolated configuration access point
After=NetworkManager.service wifi-bridge.service
PartOf=wifi-bridge.service

[Service]
Type=simple
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/var/lib/wifi-bridge/dnsmasq.conf
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/wifi-bridge
