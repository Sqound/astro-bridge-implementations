[Unit]
Description=Astro Bridge
Wants=NetworkManager.service avahi-daemon.service
After=NetworkManager.service avahi-daemon.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/wifi-bridge
ExecStart=/usr/bin/python3 -m wifi_bridge
Restart=always
RestartSec=8
TimeoutStopSec=50
UMask=0077
StateDirectory=wifi-bridge
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/etc/NetworkManager/system-connections /etc/avahi /var/lib/wifi-bridge
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET

[Install]
WantedBy=multi-user.target
