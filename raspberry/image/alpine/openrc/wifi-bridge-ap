#!/sbin/openrc-run
name="Astro Bridge setup access point"
command="/usr/sbin/hostapd"
command_args="/var/lib/wifi-bridge/hostapd.conf"
supervisor="supervise-daemon"
respawn_delay=2
respawn_max=0
output_log="/var/log/wifi-bridge-ap.log"
error_log="/var/log/wifi-bridge-ap.log"
depend() { need dbus; }
