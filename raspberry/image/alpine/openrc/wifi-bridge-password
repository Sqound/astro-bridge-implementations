#!/sbin/openrc-run
name="Astro Bridge fixed-account password task"
start() {
    if [ -f /etc/wifi-bridge/diskless ]; then
        /usr/bin/python3 /usr/libexec/astro-bridge-persist password
    else
        /usr/bin/python3 /usr/local/lib/astro-bridge/password.py || return 1
        if [ -f /usr/libexec/astro-bridge-persist ]; then
            /usr/bin/python3 /usr/libexec/astro-bridge-persist ssh && rc-service --ifstarted sshd reload
        fi
        return 0
    fi
}
stop() { return 0; }
