# Restrict the eject to the storage identity observed on the Pi 5 test adapters.
# Final assignment prevents the optional upstream 40-usb_modeswitch rule from
# dispatching a second, conflicting switch for this same device event.
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0bda", ATTR{idProduct}=="1a2b", ATTR{bcdDevice}=="0200", ATTR{manufacturer}=="Realtek", ATTR{product}=="DISK", RUN:="/bin/busybox timeout 8 /usr/sbin/usb_modeswitch -v 0x0bda -p 0x1a2b -b $attr{busnum} -g $attr{devnum} -K"
